{
  "name": "codex-dots-bridge",
  "version": "0.2.0-alpha.4",
  "private": true,
  "description": "A Windows local bridge from Codex to an existing Dot using official MCP, Tunnel and Events.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "probe": "node --import tsx src/cli.ts",
    "bridge": "node --import tsx src/main.ts",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "ipaddr.js": "2.2.0",
    "standardwebhooks": "1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
