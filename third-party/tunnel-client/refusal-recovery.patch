+// Keep the refused cause even if a later fallback only returned 404. An
+// explicitly permanent failure still vetoes retry through the classification.
+func (f discoveryResponseFailures) cause(lastErr error) error {
+	if f.connectionRefused != nil {
+		return errors.Join(lastErr, f.connectionRefused)
+	}
+	return lastErr
+}
+
+func isConnectionRefusedDiscoveryFailure(err error) bool {
+	if classified, ok := errors.AsType[*classifiedDiscoveryError](err); ok {
+		return classified.failureType == discoveryFailureTypeConnectionRefused
+	}
+	return transport.IsConnectionRefused(err)
+}
