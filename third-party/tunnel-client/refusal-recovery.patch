index 0000000..770ba65
--- /dev/null
+++ b/pkg/transport/connection_refused.go
@@ -0,0 +1,12 @@
+package transport
+
+import (
+	"errors"
+	"syscall"
+)
+
+// IsConnectionRefused checks the original error chain, never error text or the
+// broad net.Error interface. Windows uses a different native socket errno.
+func IsConnectionRefused(err error) bool {
+	return errors.Is(err, syscall.ECONNREFUSED) || isNativeConnectionRefused(err)
+}
