+	"go.uber.org/fx"
+)
+
+func startRefusalApp(t *testing.T, client *http.Client, timeout time.Duration, policy oauthDiscoveryRetryPolicy) (*DiscoveryState, *hostbus.StartupCatalogState, *recordingBus) {
+	t.Helper()
+	state, catalog := NewDiscoveryState(), hostbus.NewStartupCatalogState()
+	bus := &recordingBus{notify: make(chan struct{})}
+	serverURL, _ := url.Parse("https://mcp.example.test/mcp")
+	probe := mcpclient.NewProbeState()
+	probe.Set(nil)
+	app := fx.New(fx.NopLogger, fx.Provide(
+		func() *runtimeconfig.MCPConfig {
+			return &runtimeconfig.MCPConfig{ServerURL: serverURL, StartupWaitTimeout: timeout}
+		},
+		fx.Annotate(func() *http.Client { return client }, fx.ResultTags(`name:"mcp_client"`)),
+		func() hostbus.HostRegistrationBus { return bus },
+		func() *slog.Logger { return slog.New(slog.NewTextHandler(io.Discard, nil)) },
+		func() *mcpclient.ProbeState { return probe },
+		func() *DiscoveryState { return state },
+		func() *hostbus.StartupCatalogState { return catalog },
+	), fx.Invoke(func(p discoveryParams) error { return startOAuthDiscoveryWithRetryPolicy(p, policy) }))
+	if err := app.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = app.Stop(context.Background()) })
+	return state, catalog, bus
+}
+
+func refusalResponse(req *http.Request, status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(body)), Request: req}
+}
+
+func TestOAuthStartupRefusalRecoveryAndCatalogPending(t *testing.T) {
+	for _, stage := range []string{"protected-resource", "auth-server"} {
+		t.Run(stage, func(t *testing.T) {
+			var recovered atomic.Bool
+			entered, allow := make(chan time.Duration, 1), make(chan struct{})
+			refusal := &net.OpError{Op: "dial", Net: "tcp", Err: syscall.ECONNREFUSED}
+			client := &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+				path := req.URL.Path
+				if path == "/mcp" {
+					return refusalResponse(req, 404, ""), nil
+				}
+				if strings.Contains(path, "oauth-protected-resource") {
+					if stage == "protected-resource" && !recovered.Load() {
+						return nil, refusal
+					}
+					return refusalResponse(req, 200, `{"resource":"https://mcp.example.test/mcp","authorization_servers":["https://mcp.example.test"]}`), nil
+				}
+				if !recovered.Load() {
+					return nil, refusal
+				}
+				return refusalResponse(req, 200, `{"issuer":"https://mcp.example.test","token_endpoint":"https://mcp.example.test/token"}`), nil
+			})}
+			state, catalog, bus := startRefusalApp(t, client, time.Second, deterministicOAuthDiscoveryRetryPolicy(entered, allow))
+			select {
+			case <-entered:
+			case <-time.After(time.Second):
+				t.Fatal("refusal did not enter retry")
+			}
+			if state.IsDone() {
+				t.Fatal("refusal settled state")
+			}
+			if done, _, err := catalog.Snapshot(); done {
+				t.Fatalf("refusal settled catalog: %v", err)
+			}
+			bus.mu.Lock()
+			published := len(bus.bundles)
+			bus.mu.Unlock()
+			if published != 0 {
+				t.Fatal("refusal published partial catalog")
+			}
+			recovered.Store(true)
+			close(allow)
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			if err := catalog.Wait(ctx); err != nil {
+				t.Fatalf("catalog did not recover: %v", err)
+			}
+			if _, _, _, err, done := state.Wait(time.Second); !done || err != nil {
+				t.Fatalf("state did not recover: done=%v err=%v", done, err)
+			}
+			bus.mu.Lock()
+			defer bus.mu.Unlock()
+			if len(bus.bundles) != 1 {
+				t.Fatalf("bundles=%d", len(bus.bundles))
+			}
+		})
+	}
+}
+
+func TestOAuthRefusalDefaultAndDeadline(t *testing.T) {
+	for _, stage := range []string{"protected-resource", "auth-server"} {
+		for _, timeout := range []time.Duration{0, 40 * time.Millisecond} {
+			t.Run(stage+timeout.String(), func(t *testing.T) {
+				refusal := syscall.ECONNREFUSED
+				var waits atomic.Int32
+				client := &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+					if req.URL.Path == "/mcp" {
+						return refusalResponse(req, 404, ""), nil
+					}
+					if stage == "auth-server" && strings.Contains(req.URL.Path, "oauth-protected-resource") {
+						return refusalResponse(req, 200, `{"resource":"https://mcp.example.test/mcp","authorization_servers":["https://mcp.example.test"]}`), nil
+					}
+					return nil, refusal
+				})}
+				policy := oauthDiscoveryRetryPolicy{wait: func(ctx context.Context, delay time.Duration) bool {
+					waits.Add(1)
+					return waitForOAuthDiscoveryRetry(ctx, delay)
+				}}
+				state, catalog, _ := startRefusalApp(t, client, timeout, policy)
+				_, _, _, err, done := state.Wait(time.Second)
+				if !done {
+					t.Fatal("refusal did not settle")
+				}
+				ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+				defer cancel()
+				catalogErr := catalog.Wait(ctx)
+				if timeout == 0 {
+					if waits.Load() != 0 {
+						t.Fatal("default began retrying refusal")
+					}
+					if stage == "auth-server" {
+						if err != nil || catalogErr != nil {
+							t.Fatalf("default best effort changed: %v %v", err, catalogErr)
+						}
+					} else if !errors.Is(err, refusal) || catalogErr == nil {
+						t.Fatalf("default fail fast changed: %v %v", err, catalogErr)
+					}
+				} else if !errors.Is(err, context.DeadlineExceeded) || !errors.Is(err, refusal) || catalogErr == nil || waits.Load() != 1 {
+					t.Fatalf("deadline/cause mismatch: %v catalog=%v waits=%d", err, catalogErr, waits.Load())
+				}
+			})
+		}
+	}
+}
+
+func TestRefusalFailureAccumulationPreservesPermanentAnd404(t *testing.T) {
+	for _, permanent := range []bool{false, true} {
+		ctx := context.WithValue(context.Background(), startupConnectionRetryKey{}, true)
+		candidate, _ := url.Parse("https://mcp.example.test/first")
+		fallback, _ := url.Parse("https://mcp.example.test/last")
+		client := &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+			if req.URL.Path == "/first" {
+				return nil, syscall.ECONNREFUSED
+			}
+			if permanent {
+				return nil, syscall.EACCES
+			}
+			return refusalResponse(req, 404, ""), nil
+		})}
+		_, _, _, err := FetchOAuthMetadata(ctx, client, []DiscoveryCandidate{{URL: candidate}, {URL: fallback}}, nil, candidate)
+		want := discoveryFailureTypeConnectionRefused
+		if permanent {
+			want = discoveryFailureTypeNonTimeout
+		}
+		if classifyDiscoveryFailure(err) != want {
+			t.Fatalf("permanent=%v classification=%v err=%v", permanent, classifyDiscoveryFailure(err), err)
+		}
+		if !errors.Is(err, syscall.ECONNREFUSED) {
+			t.Fatalf("refusal cause lost: %v", err)
+		}
+	}
+}
+
+func TestStartupWaitDoesNotBoundExistingHTTPRetryPolicy(t *testing.T) {
+	var recovered atomic.Bool
+	client := &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		if req.URL.Path == "/mcp" {
+			return refusalResponse(req, 404, ""), nil
+		}
+		if !recovered.Load() {
+			return refusalResponse(req, 503, "starting"), nil
+		}
+		return refusalResponse(req, 200, `{"resource":"https://mcp.example.test/mcp"}`), nil
+	})}
+	policy := oauthDiscoveryRetryPolicy{wait: func(ctx context.Context, _ time.Duration) bool {
+		if !waitForOAuthDiscoveryRetry(ctx, 80*time.Millisecond) {
+			return false
+		}
+		recovered.Store(true)
+		return true
+	}}
+	state, catalog, _ := startRefusalApp(t, client, 20*time.Millisecond, policy)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := catalog.Wait(ctx); err != nil {
+		t.Fatalf("existing HTTP retry acquired refusal deadline: %v", err)
+	}
+	if _, _, _, err, done := state.Wait(time.Second); !done || err != nil {
+		t.Fatalf("HTTP retry did not recover: done=%v err=%v", done, err)
+	}
+}
