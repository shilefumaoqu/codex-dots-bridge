@@ -0,0 +1,51 @@
+package transport
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/url"
+	"os"
+	"runtime"
+	"syscall"
+	"testing"
+)
+
+func TestIsConnectionRefusedPreservesNativeErrorChain(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := listener.Addr().String()
+	if err := listener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	connection, err := net.Dial("tcp", address)
+	if connection != nil {
+		connection.Close()
+		t.Fatal("closed listener unexpectedly accepted")
+	}
+	if err == nil {
+		t.Fatal("expected native refusal")
+	}
+	wrapped := &url.Error{Op: "Post", URL: "http://" + address, Err: fmt.Errorf("probe: %w", err)}
+	if !IsConnectionRefused(wrapped) {
+		t.Fatalf("native error not recognized: %v", wrapped)
+	}
+	var errno syscall.Errno
+	if !errors.As(wrapped, &errno) {
+		t.Fatalf("native errno missing: %v", wrapped)
+	}
+	if runtime.GOOS == "windows" && errno != syscall.Errno(10061) {
+		t.Fatalf("Windows errno=%d, want 10061", errno)
+	}
+	for _, unrelated := range []error{nil, context.Canceled, context.DeadlineExceeded, syscall.EACCES, syscall.ECONNRESET, os.ErrNotExist, errors.New("connection refused"), &net.DNSError{IsTimeout: true}} {
+		if IsConnectionRefused(unrelated) {
+			t.Errorf("unrelated error accepted: %v", unrelated)
+		}
+	}
+	if !IsConnectionRefused(fmt.Errorf("wrapped: %w", syscall.ECONNREFUSED)) {
+		t.Fatal("portable errno rejected")
+	}
+}
diff --git a/pkg/transport/connection_refused_windows.go b/pkg/transport/connection_refused_windows.go
new file mode 100644
index 0000000..31a0c68
--- /dev/null
+++ b/pkg/transport/connection_refused_windows.go
@@ -0,0 +1,10 @@
+package transport
+
+import (
+	"errors"
+	"golang.org/x/sys/windows"
+)
+
+func isNativeConnectionRefused(err error) bool {
+	return errors.Is(err, windows.WSAECONNREFUSED)
+}
