+func TestStartupProbeNativeRefusalRequiresOptInAndRecovers(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := listener.Addr().String()
+	listener.Close()
+	connection, refusal := net.Dial("tcp", address)
+	if connection != nil {
+		connection.Close()
+		t.Fatal("expected closed listener")
+	}
+	if refusal == nil {
+		t.Fatal("expected native refusal")
+	}
+	for _, timeout := range []time.Duration{0, time.Second} {
+		state := NewProbeState()
+		attempts := 0
+		runStartupProbeWithRetry(context.Background(), startupProbeRetryOptions{
+			waitTimeout: timeout,
+			wait: func(context.Context, time.Duration) error {
+				if state.IsDone() {
+					t.Error("refusal prematurely settled probe")
+				}
+				return nil
+			},
+		}, func(context.Context) (probeSession, error) {
+			attempts++
+			if attempts == 1 {
+				return nil, refusal
+			}
+			return &fakeProbeSession{}, nil
+		}, nil, state)
+		_, finalErr, done := state.Wait(time.Second)
+		if timeout == 0 {
+			if !done || attempts != 1 || !errors.Is(finalErr, refusal) {
+				t.Fatalf("default changed: done=%v attempts=%d err=%v", done, attempts, finalErr)
+			}
+		} else if !done || attempts != 2 || finalErr != nil {
+			t.Fatalf("opt-in did not recover: done=%v attempts=%d err=%v", done, attempts, finalErr)
+		}
+	}
+}
